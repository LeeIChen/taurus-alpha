ANTHROPIC_API_KEY=
# Optional overrides
TAURUS_MODEL=claude-opus-5-5
TAURUS_EFFORT=high
# Directory of *.jsonl filing chunks loaded at startup (default: data/filings)
TAURUS_FILINGS_DIR=
# Required by scripts/fetch_filings.py (SEC asks for a name + contact email)
SEC_USER_AGENT="taurus-alpha you@example.com"
# Hybrid search embeddings (set TAURUS_EMBEDDINGS=off for BM25 only)
TAURUS_EMBEDDINGS=on
TAURUS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where /research run records are saved (default: runs/)
TAURUS_RUNS_DIR=
